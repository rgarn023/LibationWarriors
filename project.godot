; Engine configuration file.
config_version=5

[application]

config/name="Libation Warriors"
config/description="Scan bottles to summon unique 16-bit libation warriors. Collect, form parties of three, and battle locally or online."
config/version="1.1.1"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icons/app_icon.png"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
WarriorFactory="*res://scripts/autoload/warrior_factory.gd"
FactionData="*res://scripts/autoload/faction_data.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
SafeArea="*res://scripts/autoload/safe_area.gd"
UpcScanner="*res://scripts/autoload/upc_scanner.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.08, 0.07, 0.12, 1)

[android]

permissions/camera=true
permissions/internet=true
permissions/access_network_state=true

[editor_plugins]

enabled=PackedStringArray("res://addons/upc_scanner/plugin.cfg")
